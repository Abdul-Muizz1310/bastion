# Every environment variable bastion v2 reads (spec 21). Values are never committed: fill them in
# .env.local for `pnpm dev`, and in Vercel's settings for a deployment. Copy with:
#   cp .env.example .env.local

# ---- database ---------------------------------------------------------------------------------
# Neon Postgres (the shadow-admin branch). `pnpm build` migrates it only inside a Vercel build
# (VERCEL_ENV set); elsewhere run `node scripts/migrate.mjs --force`. The e2e stub run refuses any
# DATABASE_URL that is not a local Postgres (tests/e2e/README.md).
DATABASE_URL=

# ---- secrets ----------------------------------------------------------------------------------
# Root secret, at least 32 characters. Never used directly: each purpose gets its own key by
# HKDF-SHA256 (src/platform/secrets.ts) — the daily visitor ids (info bastion/visitor/v1) and the
# runner's internal advance tokens (bastion/advance/v1).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IRON_SESSION_PASSWORD=

# Ed25519 key that signs every platform token (contract v2, docs/specs/22-platform-contract-v2.md):
# PKCS#8 DER and SPKI DER, both base64. Generate: node scripts/generate-keys.mjs
BASTION_SIGNING_KEY_PRIVATE=
BASTION_SIGNING_KEY_PUBLIC=
# The key id in each token header and in /.well-known/jwks.json ([A-Za-z0-9._-]+).
# Unset or blank: bastion-ed25519-2026-04
BASTION_KEY_ID=

# ---- Upstash Redis ----------------------------------------------------------------------------
# Rate limits, the daily budgets and the shared 30 s status round. Unset: the budgets are counted
# in-process (per instance, reset on restart), each instance keeps its own status round, and the
# rate limits are OFF — every limiter lets every request through; a warning is logged once for
# each. Set but unreachable: budgets refuse (fail closed); rate limits let requests through (fail
# open).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- downstream services ----------------------------------------------------------------------
# Unset: the live Render host in src/platform/registry/products.ts. To override one, uncomment it
# with an https base URL; anything else — a blank value included — fails at startup. Never point
# one at a host on the never-use list.
# PAPER_TRAIL_BACKEND_URL=
# MAGPIE_BACKEND_URL=
# INKPRINT_BACKEND_URL=
# INKTHREAD_BACKEND_URL=
# SLOWQUERY_BACKEND_URL=
# FEATHERS_DEMO_BACKEND_URL=

# ---- daily budgets ----------------------------------------------------------------------------
# Units per UTC day, shared by every visitor (the free models allow 50 requests a day across the
# whole portfolio). A non-negative integer; unset or blank means the default in brackets.
# debates [4]
BUDGET_DEBATE=
# PDF uploads to inkthread [3]
BUDGET_UPLOAD=
# inkprint leak scans [10]
BUDGET_LEAKSCAN=
# magpie scrapes, one unit per source [30]
BUDGET_SCRAPE=
# inkprint certificates (one unit each, in a batch too) and diffs [200]
BUDGET_CERTIFY=
# feathers-demo creates and deletes [50]
BUDGET_FEATHERS_WRITE=

# ---- set by the platform, not by hand ---------------------------------------------------------
# VERCEL_ENV             a Vercel build: `pnpm build` runs the migrations first
# VERCEL_GIT_COMMIT_SHA  shown as bastion's own commit on /platform
# NODE_ENV               set by Next; production drops 'unsafe-eval' from the CSP

# ---- tests only (read by playwright.config.ts, never by the app) ------------------------------
# PLAYWRIGHT_BASE_URL    test a deployment instead: no stub, no seed, the metadata spec only
# BASTION_LIVE_SMOKE=1   with PLAYWRIGHT_BASE_URL, also run the live smoke (spends one debate)
# CI                     retries failed specs twice and forbids test.only
