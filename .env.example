NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (shadow-admin branch repurposed for bastion)
DATABASE_URL=

# Root secret (>= 32 chars). Never used directly: every purpose-specific key is derived from it
# with HKDF-SHA256 (src/platform/secrets.ts), e.g. the daily visitor ids (info bastion/visitor/v1).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IRON_SESSION_PASSWORD=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ed25519 keypair for platform JWT signing
# Generate: node scripts/generate-keys.mjs
BASTION_SIGNING_KEY_PRIVATE=
BASTION_SIGNING_KEY_PUBLIC=
BASTION_KEY_ID=bastion-ed25519-2026-04

# Downstream service URLs (override the built-in registry defaults).
# PAPER_TRAIL_BACKEND_URL default is the verified-live Render host; the bare
# `paper-trail-backend.onrender.com` slug now serves an unrelated app.
# PAPER_TRAIL_FRONTEND_URL default is the verified-live Vercel host; the bare
# `paper-trail-frontend.vercel.app` slug serves an unrelated app.
PAPER_TRAIL_BACKEND_URL=https://paper-trail-backend-jjpf.onrender.com
PAPER_TRAIL_FRONTEND_URL=https://paper-trail-frontend-sable.vercel.app
